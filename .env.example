# Database Configuration
# Use PostgreSQL when running PostgreSQL server, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cfo_dashboard
# Default out-of-the-box fallback uses SQLite for instant local execution:
DATABASE_URL=sqlite:///./cfo_dashboard.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000

# AI / LLM Configuration (Optional - intelligent rule-based intent parser operates if key omitted)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Security
SECRET_KEY=cfo-super-secret-key-decision-support-system-2026
ENVIRONMENT=development
